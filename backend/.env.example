# WanderGraph Backend Configuration Example
# Copy to .env and insert your real keys. NEVER commit your actual .env file to GitHub!

# Live places work for free with no key at all (OpenStreetMap via the Overpass API).
# Optional, free, no card: a Geoapify key makes OpenStreetMap search faster (https://www.geoapify.com/)
GEOAPIFY_API_KEY=

# Optional, needs a Google Cloud billing account: Google Places API (New) key
GOOGLE_MAPS_API_KEY=

# Which place data to use: auto (Google if its key is set, else OpenStreetMap), google, osm or curated
PLACES_PROVIDER=auto

# Optional, free tier, no card: Google Gemini API key for AI day plans (https://aistudio.google.com/)
GEMINI_API_KEY=

# Server Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
